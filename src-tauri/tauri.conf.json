{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ffScope",
  "version": "1.0.0",
  "identifier": "com.cubezeero.ffscope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ffScope",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CubeZeero",
    "copyright": "© 2026 CubeZeero",
    "homepage": "https://github.com/CubeZeero/ffScope",
    "category": "Utility",
    "shortDescription": "ffprobe GUI フロントエンド",
    "longDescription": "メディアファイルの解析・比較・ビットレート可視化を行う ffprobe GUI フロントエンド。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
